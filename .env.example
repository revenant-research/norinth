# Copy to .env for local development. NEVER commit a real .env.
# ---- Platform ----
# Path to the platform's local SQLite database (dev only; use Postgres in prod).
NORINTH_PLATFORM_DB=apps/platform/data/norinth.sqlite3
# Production: use PostgreSQL instead of SQLite (takes precedence when set).
NORINTH_DATABASE_URL=
# Bootstrap super-admin. If unset, documented dev defaults are used AND the
# account is forced to change its password on first login.
NORINTH_SUPER_ADMIN_EMAIL=
NORINTH_SUPER_ADMIN_PASSWORD=
# Session lifetime in hours.
NORINTH_SESSION_TTL_HOURS=12
# Set to "1" behind TLS so session cookies get the Secure attribute.
NORINTH_COOKIE_SECURE=0
# HMAC secret for verifying SDK ingestion batches (required in production).
NORINTH_SIGNING_SECRET=
# ---- Demo apps / SDK (local testing only) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Set to true ONLY in a controlled local environment to capture raw content.
NORINTH_CAPTURE_CONTENT=false
